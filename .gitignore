# IMPORTANT NOTES:
# 1. This .gitignore is designed for maximum security and cleanliness
# 2. Always review files before committing, especially in sensitive projects
# 3. Use 'git add -f <file>' to force-add files that should be tracked
# 4. Consider using .gitignore_global for OS-specific patterns
# 5. Update this file as the project evolves and new tools are added

# =============================================================================
# MAXIMUM PROTECTION: CATCH-ALL PATTERNS (Absolute dependency/subrepo safety)
# =============================================================================

# Catch any missed dependency directories by common names
**/deps/
**/dependencies/
**/lib/
**/libs/
**/libraries/
**/modules/
**/packages/
**/pkg/
**/pkgs/
**/components/
**/addons/
**/plugins/
**/extensions/

# Language-specific catch-alls
*/node_modules
*/bower_components
*/jspm_packages
*/web_modules
*/vendor
*/target
*/build
*/dist
*/out

# Hidden dependency directories (often created by tools)
.*/node_modules/
.*/vendor/
.*/deps/
.*-cache/
.*-modules/

# Symlinked dependencies (prevent following symlinks to dependencies)
link-modules/
linked-deps/
symlink-*/

# Tool-specific dependency patterns
.tools/
.devtools/
.dev-dependencies/
.runtime-dependencies/
.build-dependencies/

# Workspace and project artifacts that might contain dependencies
.workspace/
.project/
.settings/
.metadata/
.recommenders/

# Cache directories that might store dependencies
.cache/
cache/
.tmp-cache/
.dependency-cache/
.module-cache/
.package-cache/

# Build tool artifacts
.build/
.compile/
.compiled/
.generated/
.gen/

# Installation directories
install/
installed/
.install/
.installed/

# Archive extraction directories (temporary dependencies)
extracted/
.extracted/
unpacked/
.unpacked/

# Lock and state files for various tools
*.lock
.lock
lock.*
state.*
.state

# Temporary directories that might contain dependencies
temp-*/
tmp-*/
temporary-*/
.temp-*/
.tmp-*/
.temporary-*/

# =============================================================================
# VERIFICATION PATTERNS (Use these to test protection effectiveness)
# =============================================================================

# Test patterns - these should NEVER appear in commits:
# test-node-modules/         # Should be ignored
# test-deps/                 # Should be ignored
# test-.git/                 # Should be ignored
# test-vendor/               # Should be ignored
# .test-env                  # Should be ignored

# =============================================================================
# CRITICAL REMINDERS
# =============================================================================

# ALWAYS VERIFY BEFORE COMMITTING:
# 1. Run: git status
# 2. Run: git diff --cached
# 3. Check: No dependencies, node_modules, vendor, or .git directories
# 4. Check: No .env files or secrets
# 5. Check: File count is reasonable (not thousands of dependency files)

# EMERGENCY COMMANDS IF DEPENDENCIES ACCIDENTALLY COMMITTED:
# git reset HEAD -- node_modules/
# git reset HEAD -- vendor/
# git reset HEAD -- .git/
# git reset HEAD -- deps/

