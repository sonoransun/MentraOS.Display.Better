# =============================================================================
# DEPENDENCIES & PACKAGE MANAGERS (CRITICAL: Prevent upstream pollution)
# =============================================================================

# Node.js dependencies (PRIMARY PROTECTION - Maximum Coverage)
node_modules/
*/node_modules/
**/node_modules/
node_modules.nosync/
*node_modules*/
*node-modules*/
test-node-modules/
.node-modules/
.node_modules/

